# ThermoScope AI Environment Configuration
# Problem Statement: NTRO SIH PS ID 26162

# System Mode: 'DEMO' (default, offline-ready) or 'LIVE'
SYSTEM_MODE=DEMO

# NASA FIRMS API Configuration (https://firms.modaps.eosdis.nasa.gov/api/)
# Live mode requires a valid NASA FIRMS MAP_KEY. If unset or invalid, the system automatically falls back to DEMO mode.
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv
NASA_FIRMS_COUNTRY_CODE=IND
NASA_FIRMS_SENSOR=VIIRS_NOAA21_NRT

# OSM Overpass API Endpoint
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_TTL_HOURS=72

# Database Configuration (Defaults to local SQLite for frictionless local prototype)
DATABASE_URL=sqlite:///./thermoscope.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Simulation & Telemetry
SIMULATION_TICK_SECONDS=5
AUTO_PERSISTENCE_MIN_OBSERVATIONS=3

# Configurable Risk Engine Default Weights (Sum normalized to 1.0)
RISK_WEIGHT_INTENSITY=0.25
RISK_WEIGHT_PROXIMITY=0.25
RISK_WEIGHT_ABNORMALITY=0.20
RISK_WEIGHT_PERSISTENCE=0.15
RISK_WEIGHT_CRITICALITY=0.10
RISK_WEIGHT_CONFIDENCE=0.05
