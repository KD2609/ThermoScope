# ==============================================================================
# ThermoScope AI Geospatial Intelligence Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# In production, NEVER commit .env to version control or hardcode API keys.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL + POSTGIS (Production Source of Truth)
# ------------------------------------------------------------------------------
# Use your direct or pooled connection string from Supabase Dashboard -> Project Settings -> Database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 3. NASA FIRMS (FIRE INFORMATION FOR RESOURCE MANAGEMENT SYSTEM)
# ------------------------------------------------------------------------------
# Obtain your free 32-character MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_32_character_firms_map_key_here

# VIIRS Near-Real-Time source (VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT)
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Bounding box in lon_min,lat_min,lon_max,lat_max format (Default: India subcontinent)
FIRMS_BBOX=68.0,6.0,97.5,37.5

# Lookback window in days (1 to 10 for NRT)
FIRMS_DAYS=1
POLL_INTERVAL_MINUTES=15

# ------------------------------------------------------------------------------
# 4. ROLLING ANALYTICAL WINDOW & SPATIAL BASELINE
# ------------------------------------------------------------------------------
# Rolling historical window in days for spatial baseline (default 30 days)
# Observations older than 30 days are preserved permanently in PostgreSQL.
DEFAULT_ANALYTICAL_WINDOW_DAYS=30
SPATIAL_ANALYTICAL_RADIUS_KM=5.0
MIN_HISTORICAL_SAMPLES_REQUIRED=2

# ------------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=production-secret-thermoscope-sih-26162-key
SECRET_KEY=production-secret-thermoscope-backend-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. RISK ENGINE WEIGHTS & DANGER ZONES
# ------------------------------------------------------------------------------
RISK_WEIGHT_INTENSITY=0.30
RISK_WEIGHT_INDUSTRIAL_PROXIMITY=0.25
RISK_WEIGHT_RESIDENTIAL_PROXIMITY=0.25
RISK_WEIGHT_PERSISTENCE=0.10
RISK_WEIGHT_CONFIDENCE=0.10

DANGER_ZONE_CRITICAL_KM=1.0
DANGER_ZONE_HIGH_KM=2.0
DANGER_ZONE_MEDIUM_KM=3.0
DANGER_ZONE_LOW_KM=5.0

# ------------------------------------------------------------------------------
# 7. CARTO BASEMAPS (FRONTEND GEOSPATIAL MAPS)
# ------------------------------------------------------------------------------
# Free CARTO key to remove 'API KEY REQUIRED' watermark on CartoDB Positron tiles.
# Obtain at: https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

