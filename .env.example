# Environment Variables Template for ThermoScope AI
# Copy this file to .env and configure your credentials

# App Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# For local development: sqlite:///./thermoscope.db (zero setup required)
# For production (PostgreSQL + PostGIS): postgresql://postgres:password@localhost:5432/thermoscope
DATABASE_URL=sqlite:///./thermoscope.db

# NASA FIRMS API Credentials
# Obtain a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left blank, the system gracefully falls back to explicitly marked local baselines
NASA_FIRMS_MAP_KEY=

# FIRMS Ingestion Parameters
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Default Bounding Box for India: lon_min, lat_min, lon_max, lat_max
FIRMS_BBOX=68.0,6.0,97.5,37.5
FIRMS_DAYS=1
POLL_INTERVAL_MINUTES=15

# Security
JWT_SECRET=production-secret-thermoscope-sih-26162-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Danger Zone Distances (in Kilometers)
DANGER_ZONE_CRITICAL_KM=1.0
DANGER_ZONE_HIGH_KM=2.0
DANGER_ZONE_MEDIUM_KM=3.0
DANGER_ZONE_LOW_KM=5.0
